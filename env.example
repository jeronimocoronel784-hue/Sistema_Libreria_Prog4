# Copiar a .env y completar con valores reales. Nunca versionar .env con secretos.
#
# Este archivo lista TODAS las variables y NINGÚN secreto: los valores entre
# ángulos son marcadores de posición y hay que reemplazarlos.

# --- Base de datos -----------------------------------------------------------
# La URL se arma sola en app/core/config.py con el driver postgresql+asyncpg.
# Ninguna de estas variables tiene valor por defecto en el código: si faltan,
# la aplicación no arranca.
POSTGRES_USER=<usuario>
POSTGRES_PASSWORD=<contraseña>
POSTGRES_DB=<base>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Clave de firma del token ------------------------------------------------
# Sin valor por defecto: quien la tenga fabrica un token válido para cualquier
# usuario. Generar una con:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<clave-de-firma>

# --- bcrypt ------------------------------------------------------------------
# El coste sube con los años: va en la configuración, no fijo en el código.
BCRYPT_ROUNDS=12
# Cuántos hashes pueden correr a la vez (bcrypt tarda ~300 ms).
BCRYPT_MAX_CONCURRENT_HASHES=4

# --- Token y cookie ----------------------------------------------------------
TOKEN_EXPIRE_MINUTES=30
# Secure=true exige HTTPS: en local por HTTP va en false.
COOKIE_SECURE=false

# --- Motor asincrónico -------------------------------------------------------
POOL_SIZE=5
MAX_OVERFLOW=10
# Muestra cada consulta SQL en la consola (para la evidencia C-15).
SQL_ECHO=false
