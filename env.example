# Copiar a .env y completar con valores reales. Nunca versionar .env con secretos.
# Formato: postgresql+asyncpg://<usuario>[:<clave>]@<host>:5432/libreria
# (la clave se omite si Postgres usa autenticación trust/local sin contraseña).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/libreria
# Opcional: muestra las consultas SQL en consola para la evidencia C-07
SQL_ECHO=false
